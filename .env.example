# SchoolOS local development environment template.
# Copy this file to `.env` (git-ignored) and adjust values for your machine.
# The defaults below match the dev defaults in docker-compose.yml.

POSTGRES_USER=schoolos
POSTGRES_PASSWORD=schoolos_dev_password
POSTGRES_DB=schoolos

# ASP.NET Core reads this as ConnectionStrings:Default (double underscore = section separator).
ConnectionStrings__Default=Host=localhost;Port=15432;Database=schoolos;Username=schoolos;Password=schoolos_dev_password
