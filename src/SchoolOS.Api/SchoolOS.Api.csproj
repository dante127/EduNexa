    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolOS.Application\SchoolOS.Application.csproj" />
    <ProjectReference Include="..\SchoolOS.Infrastructure\SchoolOS.Infrastructure.csproj" />
  </ItemGroup>

